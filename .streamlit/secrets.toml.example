# Copy to .streamlit/secrets.toml (local) or paste into the app's Secrets on Streamlit Community Cloud.
# Top-level keys become environment variables, which the app reads.

# LLM (OpenAI-compatible endpoint) for the AI Solver and reply drafts
LLM_BASE_URL = "https://api.openai.com/v1"
LLM_API_KEY = "sk-..."
LLM_MODEL = "gpt-4o-mini"

# Require a password on the support-team pages (leave out for an open demo)
# AGENT_PASSWORD = "choose-a-password"

# Abuse limits (defaults shown)
# LLM_DAILY_LIMIT = "100"
# TICKETS_PER_EMAIL_HOURLY = "3"
# TICKETS_HOURLY = "60"

# Optional: email replies to customers
# SMTP_HOST = "smtp.gmail.com"
# SMTP_PORT = "587"
# SMTP_FROM = "support@yourcompany.com"
# SMTP_USER = "support@yourcompany.com"
# SMTP_PASSWORD = "your-app-password"
